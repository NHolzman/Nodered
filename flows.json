    {
        "id": "61a6bf714c67a09c",
        "type": "function",
        "z": "8f708038682bad2f",
        "name": "buzzerLong",
        "func": "if (msg.payload == \"incorrectPassword\") {\n    msg.payload = \"#buzzerLong\";\n    return msg;\n} \nreturn null;\n\n\n//redundant, may get deleted",
