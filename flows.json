    {
        "id": "39cd76e43c93da84",
        "type": "function",
        "z": "8f708038682bad2f",
        "name": "buzzerBuzz",
        "func": "if ([\"WIN_1\", \"WIN_2\", \"WIN_3\", \"DOOR\"].includes(msg.payload)) {\n    msg.payload = \"#buzzerBuzz\";\n} else {\n    return null;\n}\nreturn msg;\n",
