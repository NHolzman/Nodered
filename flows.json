        ]
    },
    {
        "id": "560c75ca8606888b",
        "type": "function",
        "z": "8f708038682bad2f",
        "name": "buzzerPulse",
        "func": "if (msg.payload == \"close\") {\n    msg.payload = \"#buzzerPulse\";\n    return msg;\n}\nreturn null;  ",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
